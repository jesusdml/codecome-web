# Generated by install.sh from deploy/templates/codecome-worker.service.in - edit the template, not this.
[Unit]
Description=CodeCome Web - worker (runs the phases; the only process with Docker)
After=network.target docker.service
Wants=docker.service

[Service]
User=@WORKER_USER@
# Its own primary group; the shared group @GROUP@ and `docker` come as supplementary groups.
Group=@WORKER_GROUP@
UMask=0002
WorkingDirectory=@PREFIX@
Environment=HOME=@WORKER_HOME@
Environment=CODECOME_ROOT=@CODECOME@
Environment=CODECOME_DATA=@DATA@
Environment=CODECOME_ARCHIVES=@ARCHIVES@
Environment=CODECOME_PROFILES=@PREFIX@/config/profiles.json
Environment=CODECOME_PRICES=@PREFIX@/config/prices.json
# API keys: a 0600 file owned by the worker's user, unreadable by the web.
EnvironmentFile=-@WORKER_HOME@/worker.env
ExecStart=@PREFIX@/.venv/bin/python @PREFIX@/worker.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
ProtectHome=@PROTECT_HOME@
ProtectSystem=full
@WORKER_RW@

[Install]
WantedBy=multi-user.target

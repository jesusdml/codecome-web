# Generated by install.sh from deploy/templates/codecome-web.service.in - edit the template, not this.
[Unit]
Description=CodeCome Web - interface (no Docker, no privileges)
After=network-online.target
Wants=network-online.target

[Service]
User=@WEB_USER@
# Its own primary group (reads the TLS key); the shared group @GROUP@ comes as a supplementary group.
Group=@WEB_GROUP@
UMask=0002
WorkingDirectory=@PREFIX@
Environment=CODECOME_ROOT=@CODECOME@
Environment=CODECOME_DATA=@DATA@
Environment=CODECOME_USERS=@DATA@/users.json
Environment=CODECOME_ARCHIVES=@ARCHIVES@
Environment=CODECOME_PROFILES=@PREFIX@/config/profiles.json
Environment=CODECOME_PRICES=@PREFIX@/config/prices.json
Environment=CODECOME_ADMINS=@ADMINS@
Environment=CODECOME_COOKIE_SECURE=1
Environment=CODECOME_TLS_CA=@TLS_DIR@/ca.crt
ExecStart=@PREFIX@/.venv/bin/uvicorn app.main:app --host @HOST@ --port @PORT@ --no-server-header \
  --ssl-keyfile @TLS_DIR@/server.key --ssl-certfile @TLS_DIR@/server.crt
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=@PROTECT_HOME@
ProtectSystem=strict
ReadWritePaths=@DATA@

[Install]
WantedBy=multi-user.target

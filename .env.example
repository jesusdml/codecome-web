#
# Environment of the two services. install.sh writes these into the systemd units for you; this
# file documents every variable. Values below are the defaults. NEVER put API keys in the web's
# environment: they belong to the worker only (and, from v1.2, to the admin view, write-only).

# ---- both services -------------------------------------------------------------------------
CODECOME_ROOT=/opt/CodeCome                  # CodeCome's workspace (Makefile, itemdb/, src/, runs/)
CODECOME_DATA=/opt/codecome-web/data         # jobs.db, ledger.db, logs, settings, secrets, uploads
CODECOME_ARCHIVES=/opt/codecome-archives     # encrypted archives (+ their unencrypted cards)
CODECOME_PROFILES=/opt/codecome-web/config/profiles.json   # from config/profiles.example.json
CODECOME_PRICES=/opt/codecome-web/config/prices.json       # model prices for the cost charts

# ---- web (codecome-web.service) ------------------------------------------------------------
CODECOME_USERS=/opt/codecome-web/data/users.json   # created with tools/adduser.py (scrypt hashes)
CODECOME_ADMINS=                             # comma-separated user names; empty = every user is admin
CODECOME_COOKIE_SECURE=1                     # session cookie only over HTTPS (set 0 only for localhost dev)
CODECOME_TLS_CA=/etc/codecome-web/tls/ca.crt # public CA certificate served at /ca.crt
CODECOME_UPLOAD_MAX_MB=500                   # largest code archive accepted by "Upload code"
# CODECOME_SECRET=                           # session signing key; default: data/secret.key (0600, created)

# ---- worker (codecome-worker.service) ------------------------------------------------------
# OPENCODE_CONFIG=/opt/codecome-web/config/opencode.json   # opencode settings used by CodeCome
# ANTHROPIC_API_KEY=                         # worker ONLY, in a 0600 EnvironmentFile it owns

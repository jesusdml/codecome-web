{
  "default": "mock",
  "profiles": {
    "mock": {
      "enabled": true,
      "env": {
        "CODECOME_MODEL": "test/mockmodel",
        "MOCKLLM_PORT": "18080",
        "CODECOME_BUSY_STALL_TIMEOUT": "90",
        "CODECOME_ALLOW_NO_SANDBOX": "1"
      }
    },
    "local": {
      "enabled": true,
      "env": {
        "CODECOME_MODEL": "local-ollama/qwen3.5:9b-32k",

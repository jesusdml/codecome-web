    },
    "opus-4-8": {
      "label": "Opus 4.8",
      "provider": "Anthropic",
      "env": {
        "CODECOME_MODEL": "anthropic/claude-opus-4-8"
      }
    },
    "qwen-local": {
      "label": "Qwen 3.5 9B",
      "provider": "Ollama (local)",
      "local": true,
      "env": {
        "CODECOME_MODEL": "local-ollama/qwen3.5:9b-32k"
      }
    },
    "lynx-local": {
      "label": "LYNX-ALPHA",
